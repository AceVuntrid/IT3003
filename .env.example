# Copy to .env and adjust before running docker compose up.

# Database
DB_NAME=uniassets
DB_USERNAME=uniassets
DB_PASSWORD=change-me-db-password

# Security — JWT_SECRET must be a long random string (48+ characters)
JWT_SECRET=change-me-to-a-long-random-secret-0123456789abcdef0123456789
JWT_ACCESS_EXPIRY=30
JWT_REFRESH_EXPIRY=14

# Development administrator (created on first start; never hard-coded)
ADMIN_EMAIL=admin@university.local
ADMIN_PASSWORD=Admin@1234

# Frontend origin allowed by CORS (the nginx entry point)
APP_FRONTEND_URL=http://localhost

# Mail (MailHog inside compose; real SMTP in production)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# File storage
STORAGE_TYPE=local
STORAGE_PATH=/app/uploads

# Demo data (org structure, categories, sample assets) — set false for production
SEED_DEMO_DATA=true
